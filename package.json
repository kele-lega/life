{
  "name": "life",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.cloud.json",
    "test": "vitest run --config vitest.config.mjs",
    "test:watch": "vitest --config vitest.config.mjs",
    "benchmark:life-statistics": "vitest run --config vitest.performance.config.mjs",
    "test:e2e": "playwright test",
    "cloud:init-test-accounts": "tsx scripts/cloud-init-test-accounts.ts",
    "cloud:migrate": "tsx --env-file=.env.local scripts/cloud-migrate.ts",
    "cloud:verify": "tsx --env-file=.env.local scripts/cloud-worker.ts",
    "cloud:otp": "tsx --env-file=.env.local scripts/cloud-drill.ts --otp",
    "cloud:drill": "tsx --env-file=.env.local scripts/cloud-drill.ts",
    "cloud:replica-accept": "tsx --env-file=.env.local scripts/cloud-replica-accept.ts",
    "cloud:replica-otp": "tsx --env-file=.env.local scripts/cloud-replica-accept.ts --otp",
    "cloud:replica-drill": "tsx --env-file=.env.local scripts/cloud-replica-drill.ts",
    "native:web": "node scripts/build-native-web.mjs",
    "native:sync": "npm run native:web && cap sync android",
    "native:open": "cap open android",
    "test:native-static": "npm run native:web && playwright test --config playwright.native.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/status-bar": "^8.0.3",
    "@radix-ui/react-icons": "^1.3.2",
    "@supabase/supabase-js": "^2.115.0",
    "dexie": "^4.4.5",
    "fflate": "^0.8.3",
    "framer-motion": "^13.2.0",
    "next": "^16.3.3",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.13",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
