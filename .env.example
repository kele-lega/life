# Phase 15: explicit extraction through the Responses API.
# Keep secrets server-side; never prefix them with NEXT_PUBLIC_.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-5.6-terra
# Defaults to OpenAI directly. An explicitly configured compatible gateway is
# identified as openai-compatible:<hostname> in local Job provenance.
AI_BASE_URL=https://api.openai.com/v1
# Localhost works by default. Public origins require explicit configuration AND
# deployment-level access protection; this origin setting is not authentication.
AI_ALLOWED_ORIGIN=

# Development-only Life Visualization demo. It is always disabled in production.
# Set to 0 locally to read only real LifeEvent statistics on /life.
NEXT_PUBLIC_LIFE_VISUALIZATION_DEMO=1

# Phase 16A: optional cloud foundation. Export/restore works without these.
# All credentials remain server-only. Never use NEXT_PUBLIC_ for cloud configuration.
CLOUD_APP_ORIGIN=https://life.kelelega.dpdns.org
# Restricted LOGIN with membership in life_cloud_app (NOT owner/superuser/worker).
CLOUD_DATABASE_URL=
# Local self-host: username:scrypt$hash accounts. Takes precedence over email OTP.
CLOUD_ACCOUNTS=
CLOUD_OBJECT_DIR=/data/objects
CLOUD_OBJECT_SIGNING_KEY=
CLOUD_AUTH_URL=
CLOUD_AUTH_KEY=
CLOUD_S3_REGION=
CLOUD_S3_BUCKET=
CLOUD_S3_ACCESS_KEY_ID=
CLOUD_S3_SECRET_ACCESS_KEY=
# Supabase Storage S3-compatible endpoint. Object keys are unique per backup;
# Supabase VersionId support is not required.
CLOUD_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
CLOUD_ACCOUNT_QUOTA_BYTES=5368709120
# Separate privileged URLs; never use them for public HTTP requests.
CLOUD_MIGRATION_DATABASE_URL=
CLOUD_WORKER_DATABASE_URL=
# Optional synthetic real-service drill (never a personal browser database).
CLOUD_TEST_EMAIL=
CLOUD_TEST_OTP=


# Phase 16B.1 durable replica. Native APKs must bake this HTTPS origin at native:web build time.
# Web replica push uses same-origin /api/replica and does not need this variable.
NEXT_PUBLIC_LIFE_CLOUD_API_ORIGIN=https://life.kelelega.dpdns.org
# Object key prefix isolation for backup and replica objects: prod | staging | dev
CLOUD_OBJECT_ENV=dev
